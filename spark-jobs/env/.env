REDIS_PORT=6379

KAFKA_BROKER=kafka:9092

AWS_REGION=us-east-2
S3_BUCKET=s3a://suntransit
PARQUET_PATH=${S3_BUCKET}/stop_times_delay
# Append-only hour-of-day history (written by analyze_daily_records.py) — full
# time-series for records + delay-prediction model training.
STOP_HOURLY_PATH=${S3_BUCKET}/stop_hourly_delay
ROUTE_HOURLY_PATH=${S3_BUCKET}/route_hourly_delay
H3_HOURLY_PATH=${S3_BUCKET}/h3_hourly_delay
COMPUTE_DELAY=1
COMPUTE_TIMEZONE=America/Phoenix
AGENCY_LIST=ValleyMetro,MassachusettsBayTransportationAuthority