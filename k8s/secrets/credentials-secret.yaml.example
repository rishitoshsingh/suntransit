# DO NOT commit real values. Generate the actual secret with:
#   kubectl create secret generic credentials -n suntransit \
#     --from-literal=AWS_ACCESS_KEY_ID=<your-key> \
#     --from-literal=AWS_SECRET_ACCESS_KEY=<your-secret> \
#     --from-literal=REDIS_PASSWORD=<your-password> \
#     --from-literal=POSTGRESQL_URL=<jdbc-url> \
#     --from-literal=UPSTASH_REDIS_REST_URL=<url> \
#     --from-literal=UPSTASH_REDIS_REST_TOKEN=<token> \
#     --dry-run=client -o yaml > k8s/secrets/credentials-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: credentials
  namespace: suntransit
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
  REDIS_PASSWORD: ""
  POSTGRESQL_URL: ""
  UPSTASH_REDIS_REST_URL: ""
  UPSTASH_REDIS_REST_TOKEN: ""
