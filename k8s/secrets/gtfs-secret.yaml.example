# DO NOT commit real values. Generate with:
#   kubectl create secret generic gtfs-keys -n suntransit \
#     --from-literal=GTFS_URL=<valley-metro-url-with-api-key> \
#     --dry-run=client -o yaml > k8s/secrets/gtfs-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: gtfs-keys
  namespace: suntransit
type: Opaque
stringData:
  GTFS_URL: ""
